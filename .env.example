# ============================================
# BHW Nutrition Tracker Backend Configuration
# ============================================

# ENVIRONMENT
NODE_ENV=development
# Options: development, production, testing

# PORT
PORT=3000

# DATABASE
MONGODB_URI=mongodb://localhost:27017/bhw-nutrition-tracker
# Example for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database-name

# JWT SECRET
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_key_in_production

# JWT EXPIRY
JWT_EXPIRY=1h

# FRONTEND URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Production: https://yourdomain.com

# HTTPS Configuration
NODE_ENV=production
HTTPS_ENABLED=false
# Set to true when deploying with HTTPS certificate

# LOGGING
LOG_LEVEL=info
# Options: error, warn, info, debug

# RATE LIMITING (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
# 900000ms = 15 minutes, 5 max requests = 5 attempts

# ADMIN USER (for seed/setup)
ADMIN_USER=admin
ADMIN_PASS=your_secure_password_here
# Note: These are used by the setup script to create initial admin
# They should NOT be used for regular login after setup

# ============================================
# SECURITY NOTES
# ============================================
# 1. Never commit this file with real values
# 2. Use .env file locally, environment variables in production
# 3. Rotate JWT_SECRET regularly
# 4. Use strong, unique passwords
# 5. Enable HTTPS in production
# 6. Keep MongoDB URI secure and use network restrictions
